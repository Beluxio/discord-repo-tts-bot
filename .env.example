# Token del bot de Discord
# Obtenlo en: https://discord.com/developers/applications
DISCORD_TOKEN=tu_token_aqui

# Ruta al ejecutable de eSpeak NG
# En Linux/Docker: espeak-ng
# En Windows: C:\Program Files\eSpeak NG\espeak-ng.exe
ESPEAK_PATH=espeak-ng

# Token del tunnel permanente de Cloudflare
# Cómo obtenerlo:
#   1. Ve a https://one.dash.cloudflare.com -> Networks -> Tunnels
#   2. Create a tunnel -> elige "Cloudflared" -> ponle nombre
#   3. Copia el token que aparece en el paso de instalación
#   4. En "Public Hostname" agrega: tu-dominio.com -> http://repo-tts-api:8000
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_tunnel_aqui
